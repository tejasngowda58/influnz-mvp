generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CREATOR
  BRAND
  ADMIN
}

enum ContentCategory {
  FASHION
  BEAUTY
  TECH
  FOOD
  FITNESS
  TRAVEL
  OTHER
}

enum CampaignStatus {
  PENDING_REVIEW
  APPROVED
  CHANGES_REQUESTED
  REJECTED
  CLOSED
}

enum ApplicationStatus {
  APPLIED
  SHORTLISTED
  BRAND_COUNTERED
  CREATOR_COUNTERED
  CONFIRMED
  CONTENT_SUBMITTED
  APPROVED
  REJECTED
}

enum OfferSide {
  CREATOR
  BRAND
}

enum ActivityActionType {
  CAMPAIGN_CREATED
  CAMPAIGN_SUBMITTED_FOR_REVIEW
  ADMIN_APPROVED
  ADMIN_REQUESTED_CHANGES
  ADMIN_REJECTED
  CREATOR_INTEREST_SUBMITTED
  COUNTER_OFFER_SENT
  COUNTER_OFFER_ACCEPTED
  COUNTER_OFFER_DECLINED
  TERMS_AGREED
  STATUS_CHANGED
  DISPUTE_RAISED
  DISPUTE_RESOLVED
}

model User {
  id                String             @id @default(uuid())
  email             String             @unique
  passwordHash      String
  role              UserRole
  createdAt         DateTime           @default(now())
  creatorProfile    CreatorProfile?
  brandProfile      BrandProfile?
  campaignActivities CampaignActivity[]
}

model CreatorProfile {
  id                          String          @id @default(uuid())
  userId                      String          @unique
  user                        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                        String
  phone                       String
  instagramHandle             String?
  contentCategory             ContentCategory
  city                        String
  followerCount               Int?
  bio                         String?
  instagramUserId             String?         @unique
  instagramProfilePictureUrl  String?
  instagramAccessToken        String?
  instagramTokenExpiresAt     DateTime?
  instagramConnectedAt        DateTime?
  applications                Application[]
}

model BrandProfile {
  id               String     @id @default(uuid())
  userId           String     @unique
  user             User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  name             String
  companyName      String
  workEmail        String
  companyWebsite   String
  industryCategory String
  city             String
  campaigns        Campaign[]
}

model Campaign {
  id             String         @id @default(uuid())
  brandId        String
  brand          BrandProfile   @relation(fields: [brandId], references: [id], onDelete: Cascade)
  title          String
  description    String
  category       ContentCategory
  city           String?
  budget         Int
  deliverables   String
  targetAudience String?
  deadline       DateTime
  negotiable     Boolean        @default(false)
  status         CampaignStatus @default(PENDING_REVIEW)
  adminComment   String?
  reviewedAt     DateTime?
  createdAt      DateTime       @default(now())
  applications   Application[]
  activities     CampaignActivity[]
}

model Application {
  id         String            @id @default(uuid())
  campaignId String
  campaign   Campaign          @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  creatorId  String
  creator    CreatorProfile    @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  pitch      String?
  proposedBudget       Int
  proposedDeliverables String
  negotiationMessage   String?
  round                Int               @default(1)
  lastOfferBy          OfferSide         @default(CREATOR)
  status     ApplicationStatus @default(APPLIED)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  activities CampaignActivity[]

  @@unique([campaignId, creatorId])
}

model CampaignActivity {
  id            String             @id @default(uuid())
  campaignId    String
  campaign      Campaign           @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  applicationId String?
  application   Application?       @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  actorId       String
  actor         User               @relation(fields: [actorId], references: [id], onDelete: Cascade)
  actorRole     UserRole
  actionType    ActivityActionType
  details       Json?
  createdAt     DateTime           @default(now())

  @@index([campaignId])
  @@index([actionType])
  @@index([createdAt])
}
