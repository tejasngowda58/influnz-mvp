DATABASE_URL="postgresql://user:password@localhost:5432/influnz?schema=public"
AUTH_SECRET="replace-with-a-random-32-byte-hex-string"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="replace-with-a-strong-password"

# Instagram OAuth (Instagram API with Instagram Login)
INSTAGRAM_APP_ID=""
INSTAGRAM_APP_SECRET=""
INSTAGRAM_REDIRECT_URI="https://your-domain-or-ngrok-url/api/instagram/callback"
INSTAGRAM_TOKEN_ENCRYPTION_KEY="generate-with-openssl-rand-base64-32"

# Where the app is reachable, used in notification emails
APP_URL="http://localhost:3000"

# Escrow payments (Razorpay). Test-mode keys are fine for development.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# Set this to the same value in the Razorpay dashboard webhook config, and
# subscribe that webhook to payment.captured, order.paid and refund.processed.
RAZORPAY_WEBHOOK_SECRET=""
# Influnz's cut of each deal, as a percentage. Defaults to 10 when unset.
PLATFORM_FEE_PERCENT="10"

# Transactional email (Resend). Emails are skipped and logged when unset.
RESEND_API_KEY=""
EMAIL_FROM="Influnz <no-reply@your-domain>"

# Shared secret for the scheduled auto-release job. Call it with
# `Authorization: Bearer $CRON_SECRET` on POST /api/cron/auto-release.
CRON_SECRET="generate-with-openssl-rand-hex-32"
